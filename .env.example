# Supabase > Project Settings > Data API  (y > API Keys para la anon key)
# Ambas son públicas por diseño: viajan al navegador y quedan dentro del bundle.
# Lo que protege los datos es Row Level Security, no el secreto de estas claves.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY
